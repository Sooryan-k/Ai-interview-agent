# --- Supabase (free tier: https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-key
# Model tiering (defaults shown)
GEMINI_TURN_MODEL=gemini-flash-lite-latest
GEMINI_SMART_MODEL=gemini-flash-lite-latest

# --- Dev/test switches ---
# GEMINI_MOCK=1        # canned AI responses; burns zero quota
# MOCK_429=1           # every AI call throws a rate-limit error (tests the 429 UX)

# --- Quotas (defaults shown) ---
GLOBAL_DAILY_CALL_CAP=800
USER_DAILY_INTERVIEW_CAP=3
USER_DAILY_STUDY_TOPIC_CAP=10

# --- Cron protection (any random string) ---
CRON_SECRET=change-me
